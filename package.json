{
  "name": "cdda-workshop",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node tools/third-party-notices.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "extract": "tsx tools/extract-data/index.ts",
    "rebuild:library": "tsx tools/rebuild-vehicle-library.ts",
    "check:library": "tsx tools/rebuild-vehicle-library.ts --check",
    "check": "tsc -b",
    "release": "npm run build && node tools/package-release.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^4.1.12"
  }
}
